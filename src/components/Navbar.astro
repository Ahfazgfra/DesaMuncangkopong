<header class="bg-emerald-800 text-white shadow-lg sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
    <!-- Logo / Judul Desa -->
    <a
      href="/"
      class="text-lg sm:text-xl font-bold flex items-center gap-2 tracking-wide"
    >
      <span>DESA MUNCANGKOPONG</span>
    </a>

    <!-- Navigasi Desktop (Sembunyikan di HP) -->
    <nav class="hidden md:flex gap-6 font-medium text-sm">
      <a
        href="/"
        class="hover:text-emerald-200 transition border-b-2 border-transparent hover:border-white pb-1"
        >Beranda</a
      >
      <a
        href="/profil"
        class="hover:text-emerald-200 transition border-b-2 border-transparent hover:border-white pb-1"
        >Profil Desa</a
      >
      <a
        href="/potensi"
        class="hover:text-emerald-200 transition border-b-2 border-transparent hover:border-white pb-1"
        >Potensi & Galeri</a
      >
      <a
        href="/berita"
        class="hover:text-emerald-200 transition border-b-2 border-transparent hover:border-white pb-1"
        >Berita</a
      >
      <a
        href="/kontak"
        class="hover:text-emerald-200 transition border-b-2 border-transparent hover:border-white pb-1"
        >Kontak & Pengaduan</a
      >
    </nav>

    <!-- Tombol Hamburger (Hanya muncul di HP) -->
    <button
      id="menu-btn"
      class="md:hidden text-white focus:outline-none p-2 rounded-lg hover:bg-emerald-700 transition"
      aria-label="Menu"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- SIDEBAR / MENU SAMPUNG KHUSUS HP -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 bg-black/60 backdrop-blur-xs z-60 hidden transition-opacity opacity-0 md:hidden"
>
</div>

<aside
  id="sidebar-menu"
  class="fixed top-0 right-0 h-full w-72 bg-emerald-900 text-white z-70 shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col p-6"
>
  <!-- Tombol Tutup (X) & Judul Sidebar -->
  <div
    class="flex justify-between items-center mb-8 border-b border-emerald-700/60 pb-4"
  >
    <span class="font-bold tracking-wide text-sm text-emerald-200"
      >MENU UTAMA</span
    >
    <button
      id="close-btn"
      class="text-white hover:text-emerald-200 p-2 rounded-full hover:bg-emerald-800 transition"
      aria-label="Tutup Menu"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Daftar Link Menu Sidebar -->
  <nav class="flex flex-col gap-4 font-medium text-base">
    <a
      href="/"
      class="px-4 py-3 rounded-xl hover:bg-emerald-800 transition flex items-center gap-3"
      >🏠 Beranda</a
    >
    <a
      href="/profil"
      class="px-4 py-3 rounded-xl hover:bg-emerald-800 transition flex items-center gap-3"
      >🏛️ Profil Desa</a
    >
    <a
      href="/potensi"
      class="px-4 py-3 rounded-xl hover:bg-emerald-800 transition flex items-center gap-3"
      >🛍️ Potensi & Galeri</a
    >
    <a
      href="/berita"
      class="px-4 py-3 rounded-xl hover:bg-emerald-800 transition flex items-center gap-3"
      >📰 Berita</a
    >
    <a
      href="/kontak"
      class="px-4 py-3 rounded-xl hover:bg-emerald-800 transition flex items-center gap-3"
      >☎️ Kontak & Pengaduan</a
    >
  </nav>

  <!-- Catatan Kaki Sidebar -->
  <div
    class="mt-auto pt-6 border-t border-emerald-700/60 text-xs text-emerald-300 text-center"
  >
    Pemerintahan Desa Muncangkopong
  </div>
</aside>

<!-- SKRIP JAVASCRIPT UNTUK MEMBUKA/MENUTUP SIDEBAR -->
<script is:inline>
  const menuBtn = document.getElementById("menu-btn");
  const closeBtn = document.getElementById("close-btn");
  const sidebarMenu = document.getElementById("sidebar-menu");
  const sidebarOverlay = document.getElementById("sidebar-overlay");

  function openMenu() {
    sidebarMenu.classList.remove("translate-x-full");
    sidebarOverlay.classList.remove("hidden");
    setTimeout(() => sidebarOverlay.classList.remove("opacity-0"), 10);
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    sidebarMenu.classList.add("translate-x-full");
    sidebarOverlay.classList.add("opacity-0");
    setTimeout(() => {
      sidebarOverlay.classList.add("hidden");
      document.body.style.overflow = "auto";
    }, 300);
  }

  menuBtn.addEventListener("click", openMenu);
  closeBtn.addEventListener("click", closeMenu);
  sidebarOverlay.addEventListener("click", closeMenu);
</script>
