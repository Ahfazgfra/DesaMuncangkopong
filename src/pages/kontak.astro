---
import Layout from "../layouts/Layout.astro";

// Ganti nomor ini dengan nomor WhatsApp aktif Kantor Desa / Kades / Kadus (Gunakan format 628xxx)
const nomorWADesa = "6281234567890";
---

<Layout title="Kontak & Pengaduan">
  <!-- Hero Banner -->
  <section
    class="bg-linear-to-r from-emerald-800 to-emerald-600 rounded-3xl p-8 sm:p-12 mb-12 text-center text-white shadow-lg"
  >
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-4">
      Kontak & Layanan Pengaduan
    </h1>
    <p
      class="text-emerald-100 text-base sm:text-lg max-w-2xl mx-auto font-light"
    >
      Sampaikan aspirasi, laporan, atau pertanyaan Anda secara langsung, mudah,
      dan transparan.
    </p>
  </section>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
    <!-- KOLOM KIRI: Formulir Pengaduan Cepat (WhatsApp Generator) -->
    <div
      class="bg-white p-8 sm:p-10 rounded-3xl shadow-sm border border-gray-100"
    >
      <h2 class="text-2xl font-bold text-gray-900 mb-2">
        📩 Kirim Pesan / Pengaduan
      </h2>
      <p class="text-gray-600 text-sm mb-6">
        Isi formulir di bawah ini. Pesan Anda akan otomatis diarahkan ke
        WhatsApp resmi pelayanan Desa Muncangkopong.
      </p>

      <form id="waForm" class="space-y-5" onsubmit="sendToWhatsapp(event)">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2"
            >Nama Lengkap</label
          >
          <input
            type="text"
            id="nama"
            required
            placeholder="Contoh: Budi Santoso"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition text-sm"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >RT / RW</label
            >
            <input
              type="text"
              id="rtrw"
              required
              placeholder="Contoh: RT 02 / RW 01"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition text-sm"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2"
              >Kategori Pesan</label
            >
            <select
              id="kategori"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition text-sm bg-white"
            >
              <option value="Layanan Administrasi">Layanan Administrasi</option>
              <option value="Laporan & Pengaduan">Laporan / Pengaduan</option>
              <option value="Usulan & Aspirasi">Usulan / Aspirasi</option>
              <option value="Lainnya">Lainnya</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2"
            >Isi Pesan / Laporan</label
          >
          <textarea
            id="pesan"
            required
            rows="4"
            placeholder="Tuliskan detail pertanyaan atau laporan Anda di sini..."
            class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition text-sm resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-4 rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center gap-2 text-base"
        >
          <span>💬 Kirim ke WhatsApp Desa</span>
        </button>
      </form>
    </div>

    <!-- KOLOM KANAN: Informasi Kontak & Peta Lokasi -->
    <div class="space-y-8 flex flex-col justify-between">
      <!-- Info Jam Operasional & Kontak -->
      <div
        class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 space-y-6"
      >
        <h3
          class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-4"
        >
          🏛️ Informasi Kantor Desa
        </h3>

        <div class="flex items-start gap-4">
          <div
            class="bg-emerald-50 text-emerald-600 p-3 rounded-xl font-bold text-xl"
          >
            📍
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-sm">Alamat Kantor</h4>
            <p class="text-gray-600 text-sm mt-1 leading-relaxed">
              Jl. Raya Muncangkopong No. 1, Desa Muncangkopong, Kec. Cikulur,
              Kabupaten Lebak, Banten.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-emerald-50 text-emerald-600 p-3 rounded-xl font-bold text-xl"
          >
            ⏰
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-sm">Jam Pelayanan Warga</h4>
            <p class="text-gray-600 text-sm mt-1">
              Senin - Jumat: 08:00 - 15:00 WIB
            </p>
            <p class="text-gray-400 text-xs mt-0.5">
              *Sabtu, Minggu & Hari Libur Nasional Tutup
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-emerald-50 text-emerald-600 p-3 rounded-xl font-bold text-xl"
          >
            ✉️
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-sm">Email Resmi</h4>
            <p class="text-gray-600 text-sm mt-1">
              pemdes.muncangkopong@gmail.com
            </p>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div
        class="bg-white p-4 rounded-3xl shadow-sm border border-gray-100 h-full flex flex-col"
      >
        <h4 class="font-bold text-gray-900 text-sm px-4 pt-2 mb-3">
          Peta Lokasi Kantor Desa
        </h4>
        <!-- iframe Google Maps standar (Bisa diganti dengan embed link akurat dari Google Maps) -->
        <div
          class="w-full grow min-h-55 rounded-2xl overflow-hidden bg-gray-100 relative"
        >
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d63428.84!2d106.18!3d-6.38!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNsKwMjInNDguMCJTIDEwNsKwMTAnNDguMCJF!5e0!3m2!1sid!2sid!4v1600000000000!5m2!1sid!2sid"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="absolute inset-0 w-full h-full object-cover"></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Script Client-side untuk menangani WhatsApp Redirect -->
  <script is:inline define:vars={{ nomorWADesa }}>
    function sendToWhatsapp(e) {
      e.preventDefault();

      const nama = document.getElementById("nama").value;
      const rtrw = document.getElementById("rtrw").value;
      const kategori = document.getElementById("kategori").value;
      const pesan = document.getElementById("pesan").value;

      const formatPesan =
        `Halo Pemdes Muncangkopong, saya ingin menyampaikan pesan dari Website Resmi:\n\n` +
        `*Nama:* ${nama}\n` +
        `*Domisili:* ${rtrw}\n` +
        `*Kategori:* ${kategori}\n\n` +
        `*Isi Pesan:*\n"${pesan}"\n\n` +
        `Terima kasih.`;

      const urlWA = `https://wa.me/${nomorWADesa}?text=${encodeURIComponent(formatPesan)}`;
      window.open(urlWA, "_blank");
    }
  </script>
</Layout>
