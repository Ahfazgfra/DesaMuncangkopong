---
import Layout from "../layouts/Layout.astro";
import dataProfil from "../data/profil.json";
---

<Layout title="Profil Desa">
  <!-- Header Profil -->
  <section
    class="bg-linear-to-r from-emerald-800 to-emerald-600 rounded-3xl p-8 sm:p-12 mb-12 text-center text-white shadow-lg"
  >
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-4">
      Profil Desa Muncangkopong
    </h1>
    <p
      class="text-emerald-100 text-base sm:text-lg max-w-2xl mx-auto font-light"
    >
      Mengenal lebih dekat sejarah, visi, misi, dan struktur pemerintahan Desa
      Muncangkopong.
    </p>
  </section>

  <!-- Konten Utama Profil (Grid 3 Kolom: 2 untuk Kiri, 1 untuk Kanan) -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12 items-start">
    <!-- KOLOM KIRI (Sejarah & Visi Misi - Porsi Lebih Lebar / 2 Kolom) -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Bagian Sejarah -->
      <section
        class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition"
      >
        <h2
          class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span class="text-2xl">📖</span> Sejarah Desa
        </h2>
        <div class="text-gray-700 leading-relaxed space-y-4 text-justify">
          <p class="text-gray-600 leading-relaxed whitespace-pre-line">
            {dataProfil.sejarah}
          </p>
        </div>
      </section>

      <!-- Bagian Visi & Misi -->
      <section
        class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition"
      >
        <h2
          class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3"
        >
          <span class="text-2xl">🎯</span> Visi & Misi
        </h2>

        <div class="mb-8">
          <h3
            class="text-lg font-bold text-emerald-700 mb-3 uppercase tracking-wide"
          >
            Visi
          </h3>
          <p class="text-gray-700 italic font-medium">
            "{dataProfil.visi}"
          </p>
        </div>

        <div>
          <h3
            class="text-lg font-bold text-emerald-700 mb-3 uppercase tracking-wide"
          >
            Misi
          </h3>
          <ol class="list-decimal list-inside text-gray-600 space-y-2">
            {dataProfil.misi.map((item) => <li>{item.teks}</li>)}
          </ol>
        </div>
      </section>
    </div>

    <!-- KOLOM KANAN (Struktur Pemerintahan & Peta Desa) -->
    <div class="space-y-8">
      <!-- Kotak Aparatur Desa -->
      <div
        class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm"
      >
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🏢</span>
          <h3 class="text-xl font-bold text-gray-900">Aparatur Desa</h3>
        </div>

        <div class="grid gap-4">
          {
            dataProfil.aparatur.map((orang) => (
              <div class="bg-emerald-50/60 border border-emerald-100/80 p-4 rounded-2xl text-center hover:bg-emerald-50 transition">
                <h4 class="font-bold text-gray-900">{orang.nama}</h4>
                <p class="text-xs text-emerald-600 font-bold uppercase tracking-wider mt-1">
                  {orang.jabatan}
                </p>
              </div>
            ))
          }
        </div>
        <p class="text-xs text-center text-gray-400 mt-6 italic">
          *Nama aparatur dapat disesuaikan kembali melalui dashboard admin.
        </p>
      </div>

      <!-- Kotak Peta Desa (Kecil, Rapi, & Bisa Diklik) -->
      <div class="bg-emerald-900 rounded-3xl p-6 text-white shadow-xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-xl">📍</span>
          <h3 class="text-lg font-bold">Peta Wilayah Desa</h3>
        </div>

        <!-- Gambar Peta (Klik untuk memperbesar) -->
        <div
          class="relative group cursor-pointer overflow-hidden rounded-2xl border border-emerald-700/50 bg-emerald-950 aspect-4/3"
          onclick="document.getElementById('modal-peta').classList.remove('hidden')"
        >
          <img
            src={dataProfil.peta_embed}
            alt="Peta Desa Muncangkopong"
            class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
          />
          <div
            class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-xs font-semibold gap-1 text-white"
          >
            🔍 Klik untuk Perbesar
          </div>
        </div>

        <p class="text-xs text-emerald-200/80 mt-3 text-center">
          Klik pada gambar untuk melihat detail.
        </p>

        <!-- Alamat Kantor Desa -->
        <div class="mt-6 pt-4 border-t border-emerald-700/50">
          <h4 class="font-bold text-emerald-300 text-sm mb-1">
            Alamat Kantor Desa:
          </h4>
          <p class="text-emerald-100 text-xs sm:text-sm leading-relaxed">
            {dataProfil.alamat}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL ZOOM PETA (POPUP FULLSCREEN) -->
  <div
    id="modal-peta"
    class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4"
    onclick="this.classList.add('hidden')"
  >
    <div
      class="relative max-w-5xl w-full bg-white rounded-3xl overflow-hidden shadow-2xl p-2"
      onclick="event.stopPropagation()"
    >
      <div class="flex justify-between items-center px-4 py-2 border-b">
        <h3 class="font-bold text-gray-900">Peta Wilayah Desa Muncangkopong</h3>
        <button
          onclick="document.getElementById('modal-peta').classList.add('hidden')"
          class="text-gray-500 hover:text-red-600 font-bold text-xl px-2"
        >
          &times;
        </button>
      </div>
      <div
        class="p-2 max-h-[80vh] overflow-auto flex justify-center bg-gray-50 rounded-b-2xl"
      >
        <img
          src={dataProfil.peta_embed}
          alt="Peta Desa Full"
          class="max-w-full h-auto object-contain rounded-xl shadow-md"
        />
      </div>
    </div>
  </div>
</Layout>
