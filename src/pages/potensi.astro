---
import Layout from "../layouts/Layout.astro";

const dataUMKM = Object.values(
  import.meta.glob("../content/umkm/*.md", { eager: true }),
) as any[];
const dataGaleri = Object.values(
  import.meta.glob("../content/galeri/*.md", { eager: true }),
) as any[];
---

<Layout title="Potensi & Galeri">
  <!-- Hero Banner -->
  <section
    class="bg-linear-to-r from-emerald-800 to-emerald-600 rounded-3xl p-8 sm:p-12 mb-12 text-center text-white shadow-lg"
  >
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-4">
      Potensi & Galeri Desa
    </h1>
    <p
      class="text-emerald-100 text-base sm:text-lg max-w-2xl mx-auto font-light"
    >
      Membangun ekonomi kreatif melalui produk UMKM unggulan dan merekam jejak
      kegiatan masyarakat Desa Muncangkopong.
    </p>
  </section>

  <!-- SEKSI 1: UMKM LOKAL (GRID CARDS) -->
  <section class="mb-16 relative">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-3">
        🛍️ Produk Unggulan & UMKM
      </h2>
      <p class="text-gray-600 text-sm sm:text-base">
        Dukung perekonomian warga desa dengan membeli produk lokal langsung dari
        perajin dan petani Desa Muncangkopong.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {/* 2. Gunakan dataUMKM dari CMS di sini */}
      {
        dataUMKM.map((item, index) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition flex flex-col justify-between group">
            <div
              class="cursor-pointer"
              onclick={`bukaModal('umkm-${index}')`}
              title="Klik untuk lihat detail"
            >
              <div class="relative overflow-hidden">
                <img
                  src={item.frontmatter.image}
                  alt={item.frontmatter.title}
                  class="w-full h-56 object-cover group-hover:scale-105 transition duration-300"
                  onerror="this.onerror=null; this.src='https://via.placeholder.com/600x400?text=Gambar+Tidak+Tersedia';"
                />
                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition" />
              </div>

              <div class="p-6 pb-2">
                <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full">
                  {item.frontmatter.penjual}
                </span>
                <h3 class="text-xl font-bold text-gray-900 mt-4 mb-2 group-hover:text-emerald-600 transition">
                  {item.frontmatter.title}
                </h3>
                <p class="text-gray-600 text-sm mb-4 leading-relaxed line-clamp-2">
                  {item.frontmatter.description}
                </p>
                <div class="text-lg font-extrabold text-emerald-600 mb-2">
                  {item.frontmatter.harga}
                </div>
              </div>
            </div>

            <div class="px-6 pb-6 pt-2 flex flex-col gap-2">
              <button
                onclick={`bukaModal('umkm-${index}')`}
                class="w-full bg-white border-2 border-emerald-600 text-emerald-700 font-bold py-2.5 px-4 rounded-xl hover:bg-emerald-50 transition text-sm flex items-center justify-center gap-2"
              >
                <span>🔍 Lihat Detail & Foto</span>
              </button>
              <a
                href={`https://wa.me/${item.frontmatter.whatsapp}?text=Halo%20${encodeURIComponent(item.frontmatter.penjual)},%20saya%20tertarik%20membeli%20produk%20${encodeURIComponent(item.frontmatter.title)}%20dari%20website%20desa.`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 transition shadow-sm text-sm"
              >
                <span>💬 Pesan Langsung</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ========================================== -->
  <!-- KUMPULAN MODAL POP-UP (Tersembunyi di awal) -->
  <!-- ========================================== -->
  {
    dataUMKM.map((item, index) => (
      <div
        id={`modal-umkm-${index}`}
        class="fixed inset-0 z-100 hidden items-center justify-center p-4 sm:p-6 opacity-0 transition-opacity duration-300"
      >
        <div
          class="absolute inset-0 bg-black/70 backdrop-blur-sm cursor-pointer"
          onclick={`tutupModal('umkm-${index}')`}
        />

        <div
          class="relative bg-white rounded-3xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto flex flex-col md:flex-row scale-95 transition-transform duration-300"
          id={`modal-content-umkm-${index}`}
        >
          <button
            onclick={`tutupModal('umkm-${index}')`}
            class="absolute top-4 right-4 z-10 bg-white/80 hover:bg-red-100 text-gray-700 hover:text-red-600 w-10 h-10 rounded-full flex items-center justify-center backdrop-blur-md transition shadow-sm"
          >
            <span class="text-xl font-bold">&times;</span>
          </button>

          <div class="w-full md:w-1/2 bg-gray-50 p-6 flex flex-col gap-4">
            <img
              src={item.frontmatter.image}
              alt={item.frontmatter.title}
              class="w-full h-64 sm:h-80 object-cover rounded-2xl shadow-sm border border-gray-200"
            />
          </div>

          <div class="w-full md:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <span class="inline-block bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full mb-4">
                UMKM Desa Muncangkopong
              </span>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2 leading-tight">
                {item.frontmatter.title}
              </h2>
              <p class="text-sm font-medium text-gray-500 mb-6 border-b border-gray-100 pb-4">
                Oleh:{" "}
                <span class="text-gray-900">{item.frontmatter.penjual}</span>
              </p>

              <div class="mb-6">
                <h4 class="text-sm font-bold text-gray-900 mb-2">
                  Deskripsi Produk:
                </h4>
                <p class="text-gray-700 text-sm leading-relaxed text-justify">
                  {item.frontmatter.description}
                </p>
              </div>

              <div class="mb-8">
                <h4 class="text-sm font-bold text-gray-900 mb-1">Harga:</h4>
                <div class="text-3xl font-black text-emerald-600">
                  {item.frontmatter.harga}
                </div>
              </div>
            </div>

            <a
              href={`https://wa.me/${item.frontmatter.whatsapp}?text=Halo%20${encodeURIComponent(item.frontmatter.penjual)},%20saya%20melihat%20produk%20${encodeURIComponent(item.frontmatter.title)}%20di%20website%20desa.%20Apakah%20masih%20tersedia?`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 px-6 rounded-2xl flex items-center justify-center gap-3 transition shadow-md hover:shadow-lg text-lg"
            >
              <span class="text-2xl">💬</span> Pesan via WhatsApp
            </a>
          </div>
        </div>
      </div>
    ))
  }

  <!-- SEKSI 2: GALERI KEGIATAN -->
  <section
    class="bg-white p-8 sm:p-12 rounded-3xl border border-gray-100 shadow-sm mb-12"
  >
    <div
      class="flex flex-col sm:flex-row justify-between items-start sm:items-end mb-8 gap-4"
    >
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-2">
          📸 Galeri Kegiatan Warga
        </h2>
        <p class="text-gray-600 text-sm">
          Dokumentasi gotong royong, pembangunan, dan acara kebudayaan desa.
        </p>
      </div>
      <div class="flex gap-2">
        <button
          onclick="geserGaleri(-1)"
          class="bg-gray-100 hover:bg-emerald-100 text-gray-700 hover:text-emerald-700 w-12 h-12 rounded-full flex items-center justify-center transition shadow-sm"
        >
          <span class="text-xl font-bold">&larr;</span>
        </button>
        <button
          onclick="geserGaleri(1)"
          class="bg-gray-100 hover:bg-emerald-100 text-gray-700 hover:text-emerald-700 w-12 h-12 rounded-full flex items-center justify-center transition shadow-sm"
        >
          <span class="text-xl font-bold">&rarr;</span>
        </button>
      </div>
    </div>

    <div
      id="slider-galeri"
      class="flex overflow-x-auto gap-5 snap-x snap-mandatory scroll-smooth pb-4 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] scrollbar-width:none"
    >
      {/* 3. Gunakan dataGaleri dari CMS di sini */}
      {
        dataGaleri.map((item) => (
          <div
            class="snap-start shrink-0 w-70 sm:w-[320px] group relative overflow-hidden rounded-2xl aspect-4/3 bg-gray-200 cursor-pointer shadow-sm hover:shadow-xl transition-all duration-300"
            onclick={`bukaFotoBesar('${item.frontmatter.image}', '${item.frontmatter.title}')`}
          >
            <img
              src={item.frontmatter.image}
              alt={item.frontmatter.title}
              class="w-full h-full object-cover group-hover:scale-110 transition duration-500 ease-in-out"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition duration-300 flex flex-col justify-end p-5">
              <span class="text-white text-base font-bold leading-tight mb-1">
                {item.frontmatter.title}
              </span>
              <span class="text-emerald-300 text-xs font-medium">
                Lihat Foto &rarr;
              </span>
            </div>
            <div class="absolute top-4 right-4 bg-black/30 backdrop-blur-md w-10 h-10 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300">
              <span class="text-white text-sm">🔍</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- POP-UP (LIGHTBOX) KHUSUS UNTUK GALERI -->
  <div
    id="lightbox-galeri"
    class="fixed inset-0 z-200 hidden items-center justify-center p-4 sm:p-8 opacity-0 transition-opacity duration-300"
  >
    <div
      class="absolute inset-0 bg-black/95 backdrop-blur-md cursor-pointer"
      onclick="tutupFotoBesar()"
    >
    </div>
    <button
      onclick="tutupFotoBesar()"
      class="absolute top-4 right-4 md:top-8 md:right-8 z-10 bg-white/10 hover:bg-red-500 text-white w-12 h-12 rounded-full flex items-center justify-center backdrop-blur-md transition shadow-lg"
    >
      <span class="text-2xl font-bold">&times;</span>
    </button>
    <div
      class="relative z-10 max-w-5xl w-full flex flex-col items-center scale-95 transition-transform duration-300"
      id="lightbox-content"
    >
      <img
        id="lightbox-img"
        src=""
        alt="Detail Kegiatan"
        class="max-w-full max-h-[75vh] rounded-xl shadow-2xl object-contain border border-gray-700/50"
      />
      <div
        class="bg-black/50 backdrop-blur-md px-6 py-3 rounded-full mt-6 border border-gray-700"
      >
        <p
          id="lightbox-caption"
          class="text-white text-base md:text-xl font-medium text-center"
        >
        </p>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  function bukaModal(id) {
    const modal = document.getElementById(`modal-${id}`);
    const modalContent = document.getElementById(`modal-content-${id}`);
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => {
      modal.classList.remove("opacity-0");
      modalContent.classList.remove("scale-95");
      modalContent.classList.add("scale-100");
    }, 10);
  }

  function tutupModal(id) {
    const modal = document.getElementById(`modal-${id}`);
    const modalContent = document.getElementById(`modal-content-${id}`);
    modal.classList.add("opacity-0");
    modalContent.classList.remove("scale-100");
    modalContent.classList.add("scale-95");
    setTimeout(() => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "auto";
    }, 300);
  }

  function geserGaleri(arah) {
    const slider = document.getElementById("slider-galeri");
    const jarakGeser = 340 * arah;
    slider.scrollBy({ left: jarakGeser, behavior: "smooth" });
  }

  function bukaFotoBesar(src, judul) {
    const lightbox = document.getElementById("lightbox-galeri");
    const lightboxContent = document.getElementById("lightbox-content");
    const img = document.getElementById("lightbox-img");
    const caption = document.getElementById("lightbox-caption");
    img.src = src;
    caption.textContent = judul;
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
    setTimeout(() => {
      lightbox.classList.remove("opacity-0");
      lightboxContent.classList.remove("scale-95");
      lightboxContent.classList.add("scale-100");
    }, 10);
  }

  function tutupFotoBesar() {
    const lightbox = document.getElementById("lightbox-galeri");
    const lightboxContent = document.getElementById("lightbox-content");
    lightbox.classList.add("opacity-0");
    lightboxContent.classList.remove("scale-100");
    lightboxContent.classList.add("scale-95");
    setTimeout(() => {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "auto";
    }, 300);
  }
</script>
