    harga: "Mulai Rp 25.000",
    wa: "6281234567890",
    gambarUtama: "https://images.unsplash.com/photo-1590736969955-71cc94901144?auto=format&fit=crop&q=80&w=600",
    galeri: [
      "https://images.unsplash.com/photo-1590736969955-71cc94901144?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1513506003901-1e6a229e9d15?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1550989460-0adf9ea622e2?auto=format&fit=crop&q=80&w=600"
    ]
  },
  {
    id: "umkm-2",
    nama: "Kripik Pisang Muncang Rasa",
    pemilik: "Ibu Siti (Dusun 2)",
    deskripsiSingkat: "Camilan renyah khas desa dari pisang kepok pilihan dengan berbagai varian rasa.",
    deskripsiLengkap: "Camilan andalan Desa Muncangkopong! Terbuat dari pisang kepok kuning hasil panen kebun warga lokal yang diiris tipis dan digoreng dengan suhu pas sehingga sangat renyah. Bebas pengawet dan menggunakan pemanis alami. Tersedia dalam varian rasa: Original, Cokelat Lumer, Balado, dan Keju Manis.",
    harga: "Rp 15.000 / bungkus",
    wa: "6281234567890",
    gambarUtama: "https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?auto=format&fit=crop&q=80&w=600",
    galeri: [
      "https://images.unsplash.com/photo-1563729784474-d77dbb933a9e?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1621852004158-f3bc188aec27?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1599599810769-bcde5a160d32?auto=format&fit=crop&q=80&w=600"
    ]
  },
  {
    id: "umkm-3",
    nama: "Madu Hutan Asli Cikulur",
    pemilik: "Kelompok Tani Lestari",
    deskripsiSingkat: "Madu murni hasil lebah liar hutan sekitar desa, tanpa campuran pemanis buatan.",
    deskripsiLengkap: "Madu hutan 100% murni dan mentah (raw honey) yang dipanen langsung oleh Kelompok Tani Lestari dari hutan di wilayah Cikulur. Kaya akan antioksidan, vitamin, dan mineral. Sangat baik untuk menjaga imunitas tubuh, meredakan batuk, serta sebagai pengganti gula yang sehat. Dikemas higienis dalam botol kaca.",
    harga: "Rp 75.000 / botol",
    wa: "6281234567890",
    gambarUtama: "https://images.unsplash.com/photo-1587049352847-4a222e784d38?auto=format&fit=crop&q=80&w=600",
    galeri: [
      "https://images.unsplash.com/photo-1587049352847-4a222e784d38?auto=format&fit=crop&q=80&w=600",
      "https://images.unsplash.com/photo-1559598467-f8b76c8155d0?auto=format&fit=crop&q=80&w=600",
