---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

// Mengambil semua berita yang ada
const semuaBerita = await getCollection("berita");
---

<Layout title="Berita Desa">
  <div class="mb-8">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">
      Berita & Pengumuman Desa
    </h1>
    <p class="text-gray-600">
      Informasi terbaru mengenai kegiatan dan pengumuman resmi Desa
      Muncangkopong.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      semuaBerita.map((item) => (
        <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition flex flex-col justify-between">
          <div>
            {item.data.image && (
              <img
                src={item.data.image}
                alt={item.data.title}
                class="w-full h-48 object-cover"
              />
            )}
            <div class="p-5">
              <span class="text-xs text-gray-400">
                {new Date(item.data.date).toLocaleDateString("id-ID")} • Oleh{" "}
                {item.data.author}
              </span>
              <h2 class="text-xl font-bold text-gray-900 mt-1 mb-2 hover:text-emerald-600 transition">
                <a href={`/berita/${item.id}`}>{item.data.title}</a>
              </h2>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                {item.data.description}
              </p>
            </div>
          </div>

          <div class="px-5 pb-5">
            <a
              href={`/berita/${item.id}`}
              class="text-emerald-600 font-semibold text-sm hover:underline"
            >
              Baca Selengkapnya &rarr;
            </a>
          </div>
        </article>
      ))
    }
  </div>
</Layout>
