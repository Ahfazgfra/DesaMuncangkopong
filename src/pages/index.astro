---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const semuaBerita = await getCollection("berita");
const beritaTerkini = semuaBerita.slice(0, 3);
---

<Layout title="Beranda">
  {/* Hero Section */}
  <section
    class="bg-gradient-to-br from-emerald-800 to-emerald-600 rounded-3xl p-8 sm:p-12 mb-12 text-center text-white shadow-xl"
  >
    <span
      class="inline-block bg-emerald-900/50 text-emerald-200 text-xs font-semibold px-3 py-1 rounded-full mb-4 border border-emerald-500/30"
    >
      Portal Informasi Resmi
    </span>
    <h1 class="text-3xl sm:text-5xl font-extrabold mb-4 leading-tight">
      Selamat Datang di Portal Resmi<br />Desa Muncangkopong
    </h1>
    <p
      class="text-emerald-100 text-base sm:text-lg max-w-2xl mx-auto mb-8 font-light"
    >
      Pusat informasi publik, transparansi kegiatan, dan layanan masyarakat desa
      secara digital.
    </p>
    <div class="flex justify-center gap-4 flex-wrap">
      <a
        href="/profil"
        class="bg-white text-emerald-900 px-6 py-3 rounded-xl font-bold hover:bg-emerald-50 transition shadow-md"
      >
        Lihat Profil Desa
      </a>
      <a
        href="/berita"
        class="bg-emerald-700/80 text-white px-6 py-3 rounded-xl font-bold hover:bg-emerald-700 transition border border-emerald-500/40"
      >
        Berita Terkini
      </a>
    </div>
  </section>

  {/* Statistik Singkat */}
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
      Statistik Singkat Desa
    </h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition"
      >
        <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 mb-1">
          3,450
        </div>
        <div class="text-xs sm:text-sm font-medium text-gray-500">
          Total Penduduk
        </div>
      </div>
      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition"
      >
        <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 mb-1">
          890
        </div>
        <div class="text-xs sm:text-sm font-medium text-gray-500">
          Kepala Keluarga
        </div>
      </div>
      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition"
      >
        <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 mb-1">
          12
        </div>
        <div class="text-xs sm:text-sm font-medium text-gray-500">RT / RW</div>
      </div>
      <div
        class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 text-center hover:shadow-md transition"
      >
        <div class="text-3xl sm:text-4xl font-extrabold text-emerald-600 mb-1">
          4
        </div>
        <div class="text-xs sm:text-sm font-medium text-gray-500">Dusun</div>
      </div>
    </div>
  </section>

  {/* Berita Terkini Section */}
  <section class="mb-12">
    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-900">Berita Terkini</h2>
      <a
        href="/berita"
        class="text-emerald-600 font-semibold hover:underline text-sm"
      >
        Lihat Semua Berita &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        beritaTerkini.map((item) => (
          <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition flex flex-col justify-between">
            <div>
              {item.data.image && (
                <img
                  src={item.data.image}
                  alt={item.data.title}
                  class="w-full h-48 object-cover"
                />
              )}
              <div class="p-5">
                <span class="text-xs text-gray-400">
                  {new Date(item.data.date).toLocaleDateString("id-ID")}
                </span>
                <h3 class="text-lg font-bold text-gray-900 mt-1 mb-2">
                  <a
                    href={`/berita/${item.id}`}
                    class="hover:text-emerald-600 transition"
                  >
                    {item.data.title}
                  </a>
                </h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                  {item.data.description}
                </p>
              </div>
            </div>

            <div class="px-5 pb-5">
              <a
                href={`/berita/${item.id}`}
                class="text-emerald-600 font-semibold text-sm hover:underline"
              >
                Baca Selengkapnya &rarr;
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
