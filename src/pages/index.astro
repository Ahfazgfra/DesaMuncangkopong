---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Pengumuman from '../components/Pengumuman.jsx';
import dataStatistik from '../data/statistik.json';
import dataBeranda from '../data/beranda.json';
// Asumsi Anda memiliki komponen CardBerita, jika tidak, kode di bawah menggunakan HTML langsung
// import CardBerita from '../components/CardBerita.astro';

// Mengambil data berita untuk ditampilkan di beranda (Maksimal 3 terbaru)
const semuaBerita = await getCollection("berita");
// Jika di content collection Anda ada field 'tanggal', gunakan sort. Jika tidak, cukup slice(0,3)
const beritaTerbaru = semuaBerita.slice(0, 9);
---

<Layout title="Beranda | Desa Muncangkopong">

    <Pengumuman client:load />
  
  <!-- 1. HERO SECTION (Banner Utama) -->
  <section
    class="relative bg-emerald-900 rounded-3xl overflow-hidden mb-16 shadow-xl"
  >
    <!-- Gambar Background -->
    <img
      src="https://images.unsplash.com/photo-1595841696677-6489ff3f8cd1?auto=format&fit=crop&q=80&w=1200"
      alt="Pemandangan Desa"
      class="absolute inset-0 w-full h-full object-cover opacity-40 mix-blend-overlay"
    />
    <div
      class="relative z-10 px-8 py-20 sm:py-32 flex flex-col items-center text-center"
    >
      <span
        class="inline-block bg-emerald-800/80 text-emerald-100 text-sm font-semibold px-4 py-1.5 rounded-full mb-6 border border-emerald-500/30 backdrop-blur-sm"
      >
        🌟 Selamat Datang di Website Resmi
      </span>
      <h1
        class="text-4xl sm:text-6xl font-extrabold text-white mb-6 leading-tight max-w-4xl"
      >
        Pemerintahan Desa <br />
        <span class="text-emerald-300">Muncangkopong</span>
      </h1>
      <p class="text-emerald-50 text-lg sm:text-xl max-w-2xl mb-10 font-light">
        Mewujudkan desa yang mandiri, sejahtera, dan berbudaya melalui pelayanan
        publik yang transparan dan digitalisasi informasi.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/profil"
          class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-3.5 rounded-xl transition shadow-lg flex items-center gap-2"
        >
          📖 Kenali Desa Kami
        </a>
        <a
          href="/kontak"
          class="bg-white/10 hover:bg-white/20 text-white backdrop-blur-md border border-white/20 font-bold px-8 py-3.5 rounded-xl transition flex items-center gap-2"
        >
          📞 Layanan Warga
        </a>
      </div>
    </div>
  </section>

  <!-- 2. AKSES CEPAT (Quick Links) -->
  <section class="mb-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <a
        href="/profil"
        class="group bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition-transform"
        >
          🏛️
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Profil & Sejarah</h3>
        <p class="text-sm text-gray-500">
          Kenali visi, misi, dan struktur pemerintahan desa.
        </p>
      </a>

      <a
        href="/potensi"
        class="group bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition-transform"
        >
          🛍️
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">UMKM & Potensi</h3>
        <p class="text-sm text-gray-500">
          Dukung produk lokal dan lihat dokumentasi kegiatan.
        </p>
      </a>

      <a
        href="/berita"
        class="group bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition-transform"
        >
          📰
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Kabar Desa</h3>
        <p class="text-sm text-gray-500">
          Informasi terbaru, pengumuman, dan agenda warga.
        </p>
      </a>

      <a
        href="/kontak"
        class="group bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center"
      >
        <div
          class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-3xl mb-4 group-hover:scale-110 transition-transform"
        >
          💬
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-2">Layanan Pengaduan</h3>
        <p class="text-sm text-gray-500">
          Sampaikan aspirasi Anda langsung ke perangkat desa.
        </p>
      </a>
    </div>
  </section>

  <!-- 3. SAMBUTAN KEPALA DESA & STATISTIK -->
  <section class="mb-20 grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
    
    <!-- KIRI: Sambutan Kades -->
    <div class="bg-linear-to-br from-emerald-50 to-white p-8 sm:p-10 rounded-3xl border border-emerald-100/50 shadow-sm relative overflow-hidden h-full">
      <!-- Ornamen Dekorasi -->
      <div class="absolute -top-10 -right-10 text-9xl opacity-5">❞</div>

      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start relative z-10">
        <img
          src={dataBeranda.foto_kades || "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=250"}
          alt="Foto Kepala Desa"
          class="w-32 h-32 sm:w-40 sm:h-40 object-cover rounded-full border-4 border-white shadow-lg"
        />
        <div class="text-center sm:text-left">
          <h2 class="text-2xl font-bold text-gray-900 mb-1">
            {dataBeranda.nama_kades}
          </h2>
          <p class="text-emerald-600 font-semibold text-sm mb-4">
            {dataBeranda.jabatan}
          </p>
          <p class="text-gray-600 text-sm italic leading-relaxed mb-4">
            "{dataBeranda.sambutan}"
          </p>
        </div>
      </div>
    </div>

    <!-- KANAN: Statistik Singkat (Otomatis dari CMS) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3 gap-4 h-full">
      {dataStatistik.daftar_statistik.map((item) => (
        <div class="bg-white p-4 sm:p-6 rounded-3xl border border-gray-100 shadow-sm flex flex-col justify-center items-center text-center hover:-translate-y-1 transition-transform duration-300">
          <span class="text-3xl sm:text-4xl mb-2">{item.ikon}</span>
          <h4 class="text-2xl sm:text-3xl font-black text-gray-900">{item.angka}</h4>
          <p class="text-gray-500 text-xs sm:text-sm font-medium mt-1 leading-tight">{item.label}</p>
        </div>
      ))}
    </div>
    
  </section>

  <!-- 4. BERITA TERKINI -->
  <section class="mb-12">
    <div
      class="flex justify-between items-end mb-8 border-b border-gray-200 pb-4"
    >
      <div>
        <h2 class="text-3xl font-extrabold text-gray-900">📰 Berita Terkini</h2>
        <p class="text-gray-500 mt-2 text-sm">
          Informasi dan agenda terbaru dari Desa Muncangkopong.
        </p>
      </div>
      <a
        href="/berita"
        class="hidden sm:flex text-emerald-600 hover:text-emerald-700 font-semibold text-sm items-center gap-1 transition"
      >
        Lihat Semua <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Grid Berita  -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {beritaTerbaru.map((berita) => (
        <a href={`/berita/${berita.id}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col h-full">
          <!-- Gambar Thumbnail -->
          <div class="relative overflow-hidden aspect-video bg-gray-200">
            <img 
              src={berita.data.image || "https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?auto=format&fit=crop&q=80&w=600"} 
              alt={berita.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
            />
          </div>
          <!-- Konten Teks -->
          <div class="p-6 flex flex-col grow">
            <div class="text-xs text-emerald-600 font-bold mb-3 flex items-center gap-2">
              <span>📅 {berita.data.date ? new Date(berita.data.date).toLocaleDateString('id-ID', {day: 'numeric', month: 'long', year: 'numeric'}) : "Terbaru"}</span>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-emerald-600 transition leading-tight">
              {berita.data.title}
            </h3>
            <p class="text-gray-600 text-sm line-clamp-3 mb-6">
              {berita.data.description || "Baca selengkapnya mengenai berita ini dengan mengklik kartu ini..."}
            </p>
            <div class="mt-auto pt-4 border-t border-gray-100 text-emerald-600 font-semibold text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
              Baca Selengkapnya <span aria-hidden="true">&rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
